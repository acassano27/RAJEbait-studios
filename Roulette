import random 

cash = 100 #cash will need to be replaced with shared currency storage

red_numbers = [1, 3, 5, 7, 9, 12, 14, 16, 18, 19, 21, 23, 25, 27, 30, 32, 34, 36]
black_numbers = [2, 4, 6, 8, 10, 11, 13, 15, 17, 20, 22, 24, 26, 28, 29, 31, 33, 35]
BetMax = True
while cash > 0:
    BetMax = True
    winning_number = random.randint(0, 36)
    if(winning_number in red_numbers):
        winning_color = 'red'
    elif(winning_number in black_numbers):
        winning_color = 'black'
    else:
        winning_color = 'green'
    print(f"You have ${cash}.")
    bet_type = input("Do you want to bet on 'red', 'black', 'number', or 'green'? ").lower()

    if bet_type == 'number':
        bet_number = int(input("Enter a number between 0 and 36: "))

        while BetMax:
            bet_amount = int(input("Enter your bet amount: "))

            if bet_amount > cash:
                print("You don't have enough cash for that bet. Try again.")
            elif bet_amount <= 0:
                print("Your bet must be greater than 0. Try again.")
            else:
                BetMax = False
        
        print(f"The winning number is {winning_number}.")
        
        if winning_number == bet_number:
            cash += bet_amount * 35 #need to adjust currency so no currency inflation
            print(f"You won! Your new balance is ${cash}.")
        else:
            cash -= bet_amount
            print(f"You lost. Your new balance is ${cash}.")

        if cash <= 0 or input("Play again? (y/n): ").lower() != 'y':
            break
    
    elif bet_type in ['red', 'black', 'green']:
        
        while BetMax:
            bet_amount = int(input("Enter your bet amount: "))
            if bet_amount > cash:
                print("You don't have enough cash for that bet. Try again.")
            elif bet_amount <= 0:
                print("Your bet must be greater than 0. Try again.")
            else:
                BetMax = False
        
        print(f"The winning color is  {winning_color}")

        if (bet_type == 'red' and winning_number in red_numbers) or (bet_type == 'black' and winning_number in black_numbers):
            cash += bet_amount
            print(f"You won! Your new balance is ${cash}.")
        elif (bet_type == 'green' and winning_number == 0):
            cash += bet_amount * 35
            print(f"You won! Your new balance is ${cash}.")
        else:
            cash -= bet_amount
            print(f"You lost. Your new balance is ${cash}.")
        BetMax = True

    else:
        print("Invalid bet type. Please choose 'red', 'black', or 'number'.")
    if cash <= 0 or input("Play again? (y/n): ").lower() != 'y':
            break